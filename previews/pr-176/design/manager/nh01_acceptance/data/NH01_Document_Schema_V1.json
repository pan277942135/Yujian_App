{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pan277942135.github.io/Yujian_App/design/manager/nh01_acceptance/data/NH01_Document_Schema_V1.json",
  "title": "NH01 Cloud Handoff Document Schema V1",
  "oneOf": [
    { "$ref": "#/$defs/sourceManifest" },
    { "$ref": "#/$defs/structure" },
    { "$ref": "#/$defs/tokens" },
    { "$ref": "#/$defs/assets" },
    { "$ref": "#/$defs/componentTree" },
    { "$ref": "#/$defs/dataBindings" },
    { "$ref": "#/$defs/responsive" },
    { "$ref": "#/$defs/evidence" },
    { "$ref": "#/$defs/androidRuntime" },
    { "$ref": "#/$defs/browserPreviewDiff" }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["schema_version", "document_type", "status", "source"],
      "properties": {
        "schema_version": { "const": 1 },
        "document_type": { "type": "string" },
        "status": { "enum": ["PASS", "REVIEW_REQUIRED", "BLOCKED", "BLOCKED_INFRA", "FAIL_ARTIFACT", "FAIL_TEST", "FAIL_EVIDENCE", "NOT_RUN", "IN_PROGRESS"] },
        "source": { "type": "object" }
      },
      "additionalProperties": true
    },
    "sourceManifest": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "document_type": { "const": "source_manifest" }, "frozen_authority": { "type": "object", "required": ["repo_path", "sha256", "expected_sha256", "status"] }, "source_contracts": { "type": "array", "minItems": 1 } }, "required": ["frozen_authority", "source_contracts", "pr164", "public_asset_review"] }
      ]
    },
    "structure": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "document_type": { "const": "structure" }, "page_id": { "type": "string" }, "frame": { "type": "object", "required": ["id", "width", "height"] }, "components": { "type": "array", "minItems": 6 }, "preview_layout": { "type": "array", "minItems": 10, "items": { "type": "object", "required": ["id", "component_id", "parent", "kind", "rect", "evidence_status"] } }, "frozen_authority": { "type": "object", "required": ["repo_path", "sha256"] } }, "required": ["page_id", "state_id", "frame", "frozen_authority", "components", "preview_layout", "preview_fixture", "figma_readback"] }
      ]
    },
    "tokens": {
      "allOf": [ { "$ref": "#/$defs/base" }, { "properties": { "document_type": { "const": "tokens" }, "figma_collection": { "type": "object" }, "colors": { "type": "array" }, "text_styles": { "type": "array" }, "font": { "type": "object" } }, "required": ["figma_collection", "colors", "text_styles", "font"] } ]
    },
    "assets": {
      "allOf": [ { "$ref": "#/$defs/base" }, { "properties": { "document_type": { "const": "assets" }, "assets": { "type": "array", "minItems": 5, "items": { "type": "object", "required": ["id", "repo_path", "sha256", "status"] } } }, "required": ["assets"] } ]
    },
    "componentTree": {
      "allOf": [ { "$ref": "#/$defs/base" }, { "properties": { "document_type": { "const": "component_tree" }, "root": { "type": "object", "required": ["id", "name", "children"] } }, "required": ["root", "mapping_completeness"] } ]
    },
    "dataBindings": {
      "allOf": [ { "$ref": "#/$defs/base" }, { "properties": { "document_type": { "const": "data_bindings" }, "bindings": { "type": "array", "minItems": 10 }, "business_binding_summary": { "type": "array", "minItems": 3 } }, "required": ["bindings", "runtime_bounds_contract", "business_binding_summary"] } ]
    },
    "responsive": {
      "allOf": [ { "$ref": "#/$defs/base" }, { "properties": { "document_type": { "const": "responsive" }, "reference": { "type": "object" }, "formula": { "type": "object" }, "modes": { "const": ["NORMAL_FIXED", "SAFE_OVERFLOW", "UNSUPPORTED_WINDOW"] }, "required_profiles": { "type": "array", "minItems": 1 } }, "required": ["reference", "formula", "modes", "required_profiles", "runtime_profile_status"] } ]
    },
    "evidence": {
      "allOf": [ { "$ref": "#/$defs/base" }, { "properties": { "document_type": { "const": "evidence_provenance" }, "figma": { "type": "object" }, "android": { "type": "object" }, "gate_status": { "type": "object", "required": ["G0_SOURCE_AUTHORITY", "G1_STRUCTURE_VALID", "G2_CLOUD_PREVIEW_VALID", "G3_COMPOSE_MAPPING_VALID", "G4_RUNTIME_VALID", "G5_VISUAL_PARITY_VALID", "G6_RESPONSIVE_VALID", "G7_DELIVERY_VALID", "G8_USER_ACCEPTANCE"] } }, "required": ["figma", "android", "design_assets", "gate_status"] } ]
    },
    "androidRuntime": {
      "allOf": [ { "$ref": "#/$defs/base" }, { "properties": { "document_type": { "const": "android_runtime" }, "device": { "type": "object" }, "artifacts": { "type": "object" }, "gate_classification": { "enum": ["PASS", "FAIL", "FAIL_ARTIFACT", "FAIL_TEST", "FAIL_EVIDENCE", "BLOCKED_INFRA", "NOT_RUN", "REVIEW_REQUIRED"] } }, "required": ["device", "artifacts", "gate_classification"] } ]
    },
    "browserPreviewDiff": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "document_type": { "const": "browser_preview_diff" }, "classification": { "enum": ["NOT_RUN", "DIAGNOSTIC_ONLY_REVIEW_REQUIRED"] }, "artifacts": { "type": "object" }, "metrics": { "type": "object" }, "rois": { "type": "array" } }, "required": ["classification", "artifacts", "metrics", "rois"] }
      ]
    }
  }
}
