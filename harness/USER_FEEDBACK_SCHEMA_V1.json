{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YuJian User Feedback V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["feedback_id", "task_id", "pr_number", "preview_source_sha", "preview_apk_sha256", "device_profile", "observed_behavior", "expected_behavior", "reproduction_steps", "evidence_links", "severity", "fix_source_sha", "replacement_apk_sha256", "user_retest_status", "feedback_status"],
  "properties": {
    "feedback_id": {"type": "string", "pattern": "^YF-[A-Z0-9][A-Z0-9_-]{2,63}$"},
    "task_id": {"type": "string", "minLength": 1},
    "pr_number": {"type": "integer", "minimum": 1},
    "preview_source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "preview_apk_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "device_profile": {"type": "object", "additionalProperties": false, "required": ["device", "api_level", "screen_px", "font_scale"], "properties": {"device": {"type": "string", "minLength": 1}, "api_level": {"type": "integer", "minimum": 1}, "screen_px": {"type": "string", "pattern": "^[0-9]+x[0-9]+$"}, "density_dpi": {"type": ["integer", "null"], "minimum": 1}, "font_scale": {"type": "number", "exclusiveMinimum": 0}}},
    "observed_behavior": {"type": "string", "minLength": 1},
    "expected_behavior": {"type": "string", "minLength": 1},
    "reproduction_steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence_links": {"type": "array", "items": {"type": "string", "format": "uri"}},
    "severity": {"enum": ["P0", "P1", "P2", "P3"]},
    "fix_source_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "replacement_apk_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "user_retest_status": {"enum": ["NOT_RUN", "PASS", "FAIL"]},
    "feedback_status": {"enum": ["OPEN", "FIXED_AWAITING_RETEST", "CLOSED"]}
  },
  "allOf": [
    {"if": {"properties": {"feedback_status": {"const": "CLOSED"}}}, "then": {"properties": {"user_retest_status": {"const": "PASS"}}}},
    {"if": {"properties": {"fix_source_sha": {"type": "string"}}}, "then": {"properties": {"replacement_apk_sha256": {"type": "string"}, "feedback_status": {"enum": ["FIXED_AWAITING_RETEST", "CLOSED"]}}}}
  ]
}
