{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YuJian Work Execution State V1",
  "type": "object",
  "required": [
    "schema_version",
    "work_id",
    "repository",
    "branch",
    "control_plane_revision",
    "base_branch",
    "base_sha",
    "phase",
    "task_id",
    "stage",
    "status",
    "source_sha",
    "checkpoint_updated_at",
    "next_action",
    "dependencies",
    "blockers",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "work_id": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "const": "pan277942135/Yujian_App"
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "control_plane_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "base_branch": {
      "const": "main"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "phase": {
      "type": "string",
      "pattern": "^P[0-9]$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "READY",
        "RUNNING",
        "VALIDATING",
        "FAIL",
        "RECOVERING",
        "BLOCKED",
        "PASS",
        "CLOSED",
        "FINAL_GATE",
        "CANCELLED"
      ]
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "checkpoint_updated_at": {
      "type": "string",
      "minLength": 1
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "object"
    },
    "delivery": {
      "type": "object",
      "required": ["artifact_class", "source_sha", "source_branch", "api28_status", "formal_status"],
      "properties": {
        "artifact_class": {"enum": ["USER_PREVIEW", "API28_INTEGRATION_CANDIDATE", "FORMAL_ACCEPTANCE", "RELEASE_CANDIDATE"]},
        "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_branch": {"type": "string", "minLength": 1},
        "api28_status": {"enum": ["NOT_RUN", "QUEUED", "RUNNING", "CORE_PASS", "PASS", "FAIL", "BLOCKED_INFRA"]},
        "formal_status": {"enum": ["NOT_ELIGIBLE", "PENDING", "CORE_PASS", "PASS", "FAIL", "BLOCKED_INFRA"]},
        "release_status": {"enum": ["NOT_ELIGIBLE", "PENDING", "PASS", "BLOCKED"]},
        "integration_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tested_source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "batch_id": {"type": "string", "minLength": 1},
        "workflow_run_id": {"type": ["integer", "string"]},
        "build_run_id": {"type": ["integer", "string"]},
        "artifact_url": {"type": "string", "format": "uri"},
        "apk_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "quick_checks": {"type": "object"},
        "required_gates": {"type": "array", "items": {"type": "string"}},
        "gate_results": {"type": "object"},
        "evidence_links": {"type": "array", "items": {"type": "string", "format": "uri"}},
        "component_prs": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": true
    },
    "user_feedback": {
      "type": "array",
      "items": {"$ref": "./USER_FEEDBACK_SCHEMA_V1.json"}
    },
    "execution_v2": {
      "type": "object",
      "required": [
        "schema_version",
        "issues"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "issues": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "task_id",
              "gate_id",
              "symptom_key",
              "failures",
              "closed"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "minLength": 1
              },
              "gate_id": {
                "type": "string",
                "minLength": 1
              },
              "symptom_key": {
                "type": "string",
                "minLength": 1
              },
              "closed": {
                "type": "boolean"
              },
              "failures": {
                "type": "array",
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "required": [
                    "source_sha",
                    "hypothesis",
                    "evidence"
                  ],
                  "properties": {
                    "source_sha": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}$"
                    },
                    "hypothesis": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidence": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
