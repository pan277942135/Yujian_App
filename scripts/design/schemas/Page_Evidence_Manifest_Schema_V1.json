{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pan277942135.github.io/Yujian_App/scripts/design/schemas/Page_Evidence_Manifest_Schema_V1.json",
  "title": "YuJian Page Freeze Evidence Manifest V1",
  "description": "Page-scoped evidence references. A PASS is exact-SHA and Run-ID bound and does not imply visual or native acceptance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "page_id",
    "contract_id",
    "contract_version",
    "contract_path",
    "contract_sha256",
    "profile_id",
    "profile_path",
    "profile_sha256",
    "state_id",
    "candidate_sha",
    "build_sha",
    "deploy_sha",
    "viewport",
    "fontScale",
    "command",
    "ci_run_id",
    "artifact_url",
    "gate_id",
    "result",
    "failure_reason",
    "photo_publication_provenance",
    "checks",
    "matrix",
    "page_acceptance",
    "generated_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "page_id": { "type": "string", "minLength": 1 },
    "contract_id": { "type": "string", "minLength": 1 },
    "contract_version": { "type": "string", "minLength": 1 },
    "contract_path": { "$ref": "#/$defs/repositoryPath" },
    "contract_sha256": { "$ref": "#/$defs/sha256" },
    "profile_id": { "type": "string", "minLength": 1 },
    "profile_path": { "$ref": "#/$defs/repositoryPath" },
    "profile_sha256": { "$ref": "#/$defs/sha256" },
    "state_id": { "type": ["string", "null"] },
    "candidate_sha": { "$ref": "#/$defs/sha1" },
    "build_sha": { "oneOf": [{ "$ref": "#/$defs/sha1" }, { "type": "null" }] },
    "deploy_sha": { "oneOf": [{ "$ref": "#/$defs/sha1" }, { "type": "null" }] },
    "viewport": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "unit"],
          "properties": {
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 },
            "unit": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "fontScale": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "command": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "ci_run_id": { "type": ["string", "null"], "pattern": "^[0-9]+$" },
    "artifact_url": { "type": ["string", "null"], "format": "uri" },
    "gate_id": { "const": "G-PAGE-FREEZE-PIPELINE-W4-TEST-EVIDENCE" },
    "result": { "enum": ["NOT_RUN", "PASS", "FAIL", "BLOCKED"] },
    "failure_reason": { "type": ["string", "null"] },
    "photo_publication_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source_sha", "run_id", "report_path", "report_sha256", "file_count", "restricted_resource_count"],
      "properties": {
        "status": { "enum": ["NOT_RUN", "PASS", "FAIL"] },
        "source_sha": { "oneOf": [{ "$ref": "#/$defs/sha1" }, { "type": "null" }] },
        "run_id": { "type": ["string", "null"], "pattern": "^[0-9]+$" },
        "report_path": { "type": ["string", "null"] },
        "report_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "file_count": { "type": ["integer", "null"], "minimum": 0 },
        "restricted_resource_count": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "resources", "pages_bundle", "browser_geometry", "browser_evidence", "native_runtime"],
      "properties": {
        "contract": { "enum": ["PASS", "FAIL", "NOT_RUN"] },
        "resources": { "enum": ["PASS", "FAIL", "NOT_RUN"] },
        "pages_bundle": { "enum": ["PASS", "FAIL", "NOT_RUN"] },
        "browser_geometry": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"] },
        "browser_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "report_path", "report_sha256", "screenshot_path", "screenshot_sha256", "dom_path", "dom_sha256", "candidate_url", "source_sha", "run_id", "visual_result"],
          "properties": {
            "status": { "enum": ["NOT_RUN", "PASS", "FAIL", "BLOCKED"] },
            "report_path": { "type": ["string", "null"] },
            "report_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
            "screenshot_path": { "type": ["string", "null"] },
            "screenshot_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
            "dom_path": { "type": ["string", "null"] },
            "dom_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
            "candidate_url": { "type": ["string", "null"], "format": "uri" },
            "source_sha": { "oneOf": [{ "$ref": "#/$defs/sha1" }, { "type": "null" }] },
            "run_id": { "type": ["string", "null"], "pattern": "^[0-9]+$" },
            "visual_result": { "const": "MEASUREMENT_ONLY_NOT_VISUAL_PASS" }
          }
        },
        "native_runtime": { "const": "NOT_VERIFIED" }
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source_path", "expected_case_count", "recorded_case_count", "cases", "reason"],
      "properties": {
        "status": { "enum": ["NOT_RUN", "PASS", "FAIL", "BLOCKED"] },
        "source_path": { "type": ["string", "null"] },
        "expected_case_count": { "type": "integer", "minimum": 0 },
        "recorded_case_count": { "type": "integer", "minimum": 0 },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["case_id", "viewport", "font_scale", "state_id", "result", "failure_reason"],
            "properties": {
              "case_id": { "type": "string", "minLength": 1 },
              "viewport": { "type": ["object", "null"] },
              "font_scale": { "type": ["number", "null"] },
              "state_id": { "type": ["string", "null"] },
              "result": { "enum": ["NOT_RUN", "PASS", "FAIL", "BLOCKED"] },
              "failure_reason": { "type": ["string", "null"] },
              "evidence_path": { "type": ["string", "null"] },
              "evidence_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
              "source_sha": { "oneOf": [{ "$ref": "#/$defs/sha1" }, { "type": "null" }] },
              "run_id": { "type": ["string", "null"], "pattern": "^[0-9]+$" }
            }
          }
        },
        "reason": { "type": ["string", "null"] }
      }
    },
    "page_acceptance": { "const": "NOT_VERIFIED" },
    "generated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    }
  }
}
