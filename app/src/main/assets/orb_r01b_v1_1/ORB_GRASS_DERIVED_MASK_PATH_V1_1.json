  "method": "manually traced fixed-source ROI polygons, feathered 11px and gated by HSV green-material confidence; no generated leaves",
  "maskPipeline": {
    "polygonRaster": "cv2.fillPoly",
    "featherSigmaPxAt1254": 11.0,
    "hueOpenCV8Bit": {
      "lower": 30,
      "lowerRamp": 13,
      "upper": 91,
      "upperRamp": 16
    },
    "saturationRamp": {
      "start": 30,
      "fullAt": 120
    },
    "valueRamp": {
      "start": 18,
      "fullAt": 108
    },
    "confidenceFormula": "clamp((H-30)/13,0,1)*clamp((91-H)/16,0,1)*clamp((S-30)/90,0,1)*clamp((V-18)/90,0,1)*(sourceAlpha/255)",
    "finalMaskFormula": "gaussianFeather(polygon, sigma=11px) * (0.15+0.85*confidence) * 255",
    "colorSpace": "OpenCV HSV, hue 0..179, saturation/value 0..255"
  },
  "coordinates": {
    "space": "sourceUV",
    "origin": "upper_left",
    "xRight": true,
    "yDown": true,
    "normalize": [
      "x/1254",
      "y/1254"
    ],
    "noAssumptionAboutRuntimeWebPCrop": true
  },
  "runtimeSample": {
    "algorithm": "single-original-core-draw with per-pixel grass-gated displacement; do not duplicate the already baked leaf pixels",
    "texelFormula": "mix(sampleOriginal(uv), sampleOriginal(uv - localDisplacementUV(uv, t)), maskAlpha(uv))",
    "rootConstraint": "zero displacement at root; tip peak at 100% root-to-tip arc-length",
    "feather": "existing feathered alpha mask; preserve lens/caustics border and upper-left sunlight",
    "amplitudeUnits": "fraction of visible core diameter D",
    "phase": "sin(2*pi*sceneElapsedMs/periodMs + radians(phaseDeg))",
    "tipDirection": "normal to existing traced leaf centerline, not global rigid rotation",
    "envelope": "smoothstep(0.10,1.0,arcLengthFraction)^1.6",
    "noExtraSurface": "do not create a new GLSurfaceView or independent EGL host",
    "android16Preferred": "RenderEffect/RuntimeShader or equivalent shader pathway integrated with existing core renderer; keep original source bitmap immutable",
    "fallback": "If hardware/shader path is unavailable, retain original core and animate source-matched sunlight/caustics response; do not draw displaced duplicate leaves",
    "doNotClaimUnsupportedRendererValidated": true
  },
