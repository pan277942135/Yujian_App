{
  "version": "1.2",
  "depends_on_common_package": "YuJian_home_empty_frontend_assets_V1.2",
  "screen": {
    "edge_to_edge": true,
    "background": "COMMON:assets/background/home_empty_bg_no_bobber.webp",
    "content_scale": "Crop",
    "content_safe_area": true
  },
  "header": {
    "title": "我的鱼获",
    "title_sp": 20,
    "avatar_dp": 40
  },
  "stats": {
    "fields": [
      "speciesCount",
      "catchCount",
      "recordDays"
    ],
    "container": "none",
    "visual_weight": "secondary"
  },
  "recent": {
    "title": "最近鱼获",
    "carousel": false,
    "single_record_only": true,
    "card_width_ratio": 0.78,
    "card_height_ratio": 0.25
  },
  "cta": {
    "label": "记录下一条鱼",
    "camera": "COMMON:assets/camera/*",
    "motion": "COMMON:config/camera_breath.json"
  }
}