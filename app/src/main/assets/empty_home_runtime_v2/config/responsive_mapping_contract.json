{
  "design_version": "Empty_Home_Final_Design_V2",
  "visual_revision": "V2.2",
  "contract_revision": "EMPTY_HOME_RESPONSIVE_MAPPING_V1",
  "purpose": "Engineering translation of the frozen 1080x1920 artwork and approved V2.2 deltas; this contract does not redesign the page.",
  "reference_canvas": [
    1080,
    1920
  ],
  "supported_portrait_aspect_ratios_width_to_height": [
    "9:16",
    "9:18",
    "9:19.5",
    "9:20",
    "9:21"
  ],
  "adaptive_profile_authority": "app/src/main/java/com/yujian/ai/ui/adaptive/AdaptiveLayoutContract.kt",
  "safe_drawing_insets": {
    "source": "WindowInsets.safeDrawing",
    "apply_system_insets_exactly_once": true,
    "header_edge": "top",
    "cta_edge": "bottom",
    "scene_canvas": "edge_to_edge_app_viewport",
    "scene_transform_uses_safe_viewport": false
  },
  "width_profiles_dp": [
    {
      "class": "COMPACT",
      "minimum": 320,
      "maximum": 320
    },
    {
      "class": "STANDARD",
      "minimum": 321,
      "maximum": 360
    },
    {
      "class": "MEDIUM",
      "minimum": 361,
      "maximum": 410
    },
    {
      "class": "WIDE",
      "minimum": 411,
      "maximum": null
    }
  ],
  "height_profiles_safe_viewport_dp": [
    {
      "class": "SHORT",
      "minimum_exclusive": 0,
      "maximum_exclusive": 600
    },
    {
      "class": "STANDARD",
      "minimum_inclusive": 600,
      "maximum_exclusive": 720
    },
    {
      "class": "TALL",
      "minimum_inclusive": 720,
      "maximum": null
    }
  ],
  "font_scale_profiles": [
    1.0,
    1.3
  ],
  "groups": {
    "scene_space": {
      "transform_id": "sceneTransform",
      "strategy": "UNIFORM_COVER_COMPOSITION_AWARE",
      "formula": "scale=max(viewportWidth/1080,viewportHeight/1920); offsetX=clamp(centeredOffsetX,-protectedLeft*scale,viewportWidth-protectedRight*scale); offsetY=(viewportHeight-1920*scale)/2",
      "coordinate_space": "reference_canvas_px",
      "elements": [
        "scene_base",
        "cloud",
        "sun_beam",
        "sun_particles",
        "rod",
        "fishing_line",
        "bobber",
        "water_contact",
        "ripple"
      ],
      "all_scene_locked_elements_share_transform": true,
      "independent_x_y_scale_for_scene_locked_elements": false,
      "fishing_protected_bounds_reference_px": {
        "left": 0,
        "top": 1180,
        "right": 660,
        "bottom": 1380
      },
      "overflow_crop_policy": "preserve_left_fishing_composition_and_crop_right_side_decorative_environment"
    },
    "safe_top_ui": {
      "strategy": "SAFE_TOP_ANCHORED",
      "inset_source": "WindowInsets.safeDrawing",
      "top_margin_after_safe_inset_dp": 16,
      "maximum_content_width_dp": 430,
      "minimum_touch_target_dp": 48,
      "elements": [
        "logo",
        "subtitle",
        "login",
        "profile"
      ],
      "position_independent_of_scene_crop": true
    },
    "hero_copy": {
      "strategy": "ASPECT_LOCKED_REFERENCE_ANCHOR",
      "measurement_source": "design/pages/home/empty_home/source/frozen/Empty_Home_Final_Design_V2_normalized_1080x1920.png",
      "reference_machine_bbox_px": {
        "x": 50,
        "y": 224,
        "width": 620,
        "height": 310
      },
      "reference_aspect_ratio": 2.0,
      "visible_ink_and_gold_measurement_px": {
        "left": 80,
        "top": 245,
        "right_exclusive": 675,
        "bottom_exclusive": 535
      },
      "visible_measurement_method": "Pixel inspection of the normalized frozen PNG in the Hero region; visual ink/gold extent recorded for traceability, not used to regenerate artwork.",
      "width_policy": "safeWidthDp * 620/1080, capped at 620dp",
      "minimum_width_dp_at_supported_320dp_profile": 183.7,
      "maximum_width_dp": 620,
      "horizontal_anchor": "safe viewport start + safeWidthDp * 50/1080",
      "top_band_anchor": "safe viewport top + safeHeightDp * 224/1920",
      "height_policy": "renderedWidth / 2.0",
      "content_scale": "FIT",
      "stretch": false,
      "fill_bounds": false
    },
    "capture_cta_group": {
      "strategy": "SAFE_BOTTOM_ANCHORED_GROUP",
      "elements": [
        "prompt",
        "camera_button",
        "album_action"
      ],
      "all_elements_share_group_layout": true,
      "reference_geometry_px": {
        "prompt_top": 1448,
        "prompt_to_camera_clear_gap_minimum": 25,
        "camera_top": 1537,
        "camera_size": 220,
        "camera_to_album_clear_gap_minimum": 23,
        "album_top": 1780,
        "album_top_to_reference_bottom": 140
      },
      "reference_relationships": "Prompt, Camera and Album anchors are measured in one CTA group. Camera is 220px square; visual clear gaps remain at least 25px and 23px respectively. Prompt and Album heights remain content-driven.",
      "group_scale": "safeWidthDp/1080",
      "vertical_anchor": "translate the group so its reference-canvas bottom aligns with safe viewport bottom: translateY=safeHeightDp-1920*(safeWidthDp/1080); anchor offsets use the same group scale",
      "bottom_overflow_compensation": "move the whole group upward only when the 48dp Album touch target would extend below the safe viewport",
      "accessibility_reflow": "move Prompt upward only as needed to retain its 24sp line-height and minimum 25px reference clear gap before Camera",
      "prompt_and_album_height": "content_driven",
      "minimum_touch_target_dp": 48
    }
  },
  "short_viewport_behavior": {
    "reflow_or_scroll": true,
    "shrink_required_typography": false,
    "clip_required_actions": false,
    "allow_cta_safe_bottom_relayout": true
  },
  "responsive_profiles_to_verify": [
    {
      "width_dp": 320,
      "height_dp": 640
    },
    {
      "width_dp": 360,
      "height_dp": 780
    },
    {
      "width_dp": 393,
      "height_dp": 852
    },
    {
      "width_dp": 411,
      "height_dp": 891
    }
  ],
  "responsive_scene_capture_targets_px": [
    {
      "width": 1080,
      "height": 1920
    },
    {
      "width": 1080,
      "height": 2160
    },
    {
      "width": 1080,
      "height": 2340
    },
    {
      "width": 1080,
      "height": 2400
    },
    {
      "width": 720,
      "height": 1600
    },
    {
      "width": 320,
      "height": 640,
      "validation": "STRUCTURAL_ONLY"
    }
  ]
}
