{
  "contract": "recognition_result_species_selector",
  "version": "V1",
  "status": "FROZEN",
  "scope": "SPECIES_SELECTOR_ONLY",
  "visual_authority": "design/pages/recognition/result/species_selector/frozen/Recognition_Result_Species_Selector_V1_Frozen.png",
  "visual_manifest": "design/pages/recognition/result/species_selector/frozen/manifest.json",
  "top_navigation": {
    "authority": "design/system/components/top_navigation/back_title/visual_contract.json",
    "variant": "BACK_TITLE",
    "title": "选择鱼种",
    "large_centered_title": false
  },
  "information_architecture": {
    "query_empty": [
      "BACK_TITLE",
      "Search",
      "最近选择",
      "常见鱼种",
      "全部鱼种",
      "Context-aware Bottom Safe Area"
    ],
    "query_nonempty": [
      "BACK_TITLE",
      "Search",
      "Search Results"
    ],
    "hidden_while_searching": [
      "最近选择",
      "常见鱼种",
      "全部鱼种"
    ]
  },
  "search": {
    "match_fields": [
      "formal_chinese_name",
      "pinyin",
      "pinyin_initials",
      "registered_alias"
    ],
    "example": {
      "queries": [
        "草鱼",
        "caoyu",
        "cy"
      ],
      "same_species_id": true
    },
    "debounce_ms": 300,
    "states": [
      "IDLE",
      "SEARCHING",
      "RESULTS",
      "EMPTY"
    ],
    "empty_copy": "没有找到相关鱼种",
    "empty_action": "清除搜索",
    "v1_hidden_action": "找不到我的鱼种？"
  },
  "recent": {
    "max_items": 3,
    "write_only_on_user_commit": true,
    "ai_top1_auto_write": false,
    "order": "newest_first",
    "deduplicate_by": "species_id",
    "reselect": "move_to_first"
  },
  "common_species": {
    "max_items": 6,
    "breakpoints": [
      {
        "min_width_dp": 360,
        "columns": 3,
        "rows": 2
      },
      {
        "width_dp": 320,
        "columns": 2,
        "rows": 3
      }
    ],
    "card_fields": [
      "fish_image",
      "species_name"
    ],
    "prohibited_fields": [
      "confidence",
      "rarity",
      "fish_guide_detail",
      "discovered_badge",
      "description"
    ]
  },
  "all_species": {
    "group_by": "pinyin_initial_of_formal_chinese_name",
    "row_height_dp": [
      64,
      68
    ],
    "fish_media_dp": [
      56,
      40
    ],
    "name": {
      "font_sp": 16,
      "line_height_sp": 22,
      "max_lines": 2
    },
    "chevron_dp": 18,
    "selected_row": [
      "fish",
      "name",
      "check"
    ],
    "selected_hides_chevron": true
  },
  "species_media": {
    "authority_chain": [
      "Fish Knowledge",
      "species_id",
      "cover_image"
    ],
    "shared_consumers": [
      "Fish Guide",
      "Medium Candidate",
      "Species Selector"
    ],
    "missing_media": "NEUTRAL_FISH_PLACEHOLDER",
    "prohibited": [
      "other_species_substitute",
      "generated_fish",
      "frozen_screenshot_crop",
      "text_鱼_placeholder",
      "selector_specific_artwork_system"
    ]
  },
  "selection": {
    "color": "#0F7A78",
    "border_dp": 2,
    "fill_opacity_percent": [
      6,
      8
    ],
    "check_circle": "#0F7A78",
    "check": "#FFFFFF",
    "legacy_gold_selected_state": "RETIRED",
    "synchronize_across": [
      "recent",
      "common",
      "all"
    ]
  },
  "tap_commit": {
    "feedback_ms": [
      100,
      150
    ],
    "commit": "species_id",
    "return_to": "Recognition Result",
    "confirmation_button": false
  },
  "entry_contexts": {
    "context_type": "SpeciesSelectorEntryContext",
    "values": {
      "EDIT_CONFIRMED": {
        "entry": "High or resolved Result → 修改鱼种",
        "preselect_current_species": true,
        "back": "cancel_and_keep_previous_species",
        "allow_unconfirmed": false
      },
      "MEDIUM_OTHER": {
        "entry": "Medium → 都不是？选择其他鱼种",
        "allow_unconfirmed": true,
        "unconfirmed_returns": "Medium unresolved",
        "creates_fish_record_on_unconfirmed": false
      },
      "LOW_MANUAL": {
        "entry": "Low → 手动选择鱼种",
        "allow_unconfirmed": true,
        "unconfirmed_returns": "Low unresolved",
        "creates_fish_record_on_unconfirmed": false
      }
    },
    "unconfirmed_action": "暂不确认鱼种"
  },
  "responsive": {
    "widths_dp": [
      320,
      360,
      393,
      411
    ],
    "compact_320": {
      "recent": "wrap",
      "common_columns": 2,
      "all_columns": 1
    },
    "width_360_or_more_common_columns": 3,
    "font_scale": {
      "common_name_max_lines": 2,
      "list_name_max_lines": 2,
      "rows_may_grow": true,
      "shrink_text_to_force_single_line": false
    }
  },
  "background": {
    "variant": "BG_CONTENT",
    "not_variant": "BG_ENV_HERO",
    "environment_salience_relative_to_home": 0.75,
    "glass_rules": [
      "preserve_lake",
      "slightly_raise_white_base_for_all_species",
      "no_hard_pure_white_card",
      "content_legibility_over_scenery"
    ]
  },
  "logical_states": [
    "SS01_DEFAULT",
    "SS02_SELECTED",
    "SS03_SEARCH_RESULTS",
    "SS04_SEARCH_EMPTY",
    "SS05_320DP_COMPACT",
    "SS06_EDIT_CONFIRMED",
    "SS07_MEDIUM_OTHER",
    "SS08_LOW_MANUAL"
  ],
  "frozen_board_is_composite": true,
  "no_separate_pngs_required": true,
  "result_frozen_states_05_09_unchanged": true
}
