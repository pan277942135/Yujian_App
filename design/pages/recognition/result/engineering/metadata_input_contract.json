{
  "contract": "recognition_result_metadata_input",
  "version": "V1.1",
  "status": "FROZEN",
  "applies_to": ["HIGH", "MEDIUM_AFTER_SELECTION", "LOW_BEFORE_SELECTION", "LOW_AFTER_SELECTION"],
  "presentation": {
    "surface": "MistGlass",
    "layout": "vertical_three_row",
    "fields": [
      { "key": "length", "label": "长度", "empty": "请输入", "example": "42.6 cm" },
      { "key": "weight", "label": "重量", "empty": "请输入", "example": "1.28 kg" },
      { "key": "location", "label": "地点", "empty": "请选择", "example": "千岛湖" }
    ]
  },
  "length": {
    "title": "鱼获长度",
    "unit": "cm",
    "keyboard": "decimal",
    "optional": true,
    "range": [0.1, 999.9],
    "precision": 1,
    "error": "请输入 0.1–999.9 cm 的长度"
  },
  "weight": {
    "title": "鱼获重量",
    "unit": "kg",
    "keyboard": "decimal",
    "optional": true,
    "range": [0.01, 999.99],
    "precision": 2,
    "error": "请输入 0.01–999.99 kg 的重量"
  },
  "location": {
    "title": "鱼获地点",
    "search": true,
    "current_location": "explicit_action_only",
    "recent_max": 3,
    "commit": "immediate_on_selection",
    "navigation": "same_page_bottom_sheet"
  },
  "story": {
    "title": "写下这次鱼获的故事",
    "placeholder": "记录这一刻的感受……",
    "max_unicode_code_points": 300,
    "counter": "{count}/300",
    "multiline": true
  }
}
