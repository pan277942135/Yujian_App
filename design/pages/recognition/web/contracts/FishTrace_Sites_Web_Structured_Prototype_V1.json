  },
  "design_decisions": {
    "experience": "IMMERSIVE_SINGLE_SCENE",
    "source_choice_first": [
      "现场拍照",
      "从相册选择"
    ],
    "desktop_result_layout": "PHOTO_LEFT_RESULT_RIGHT",
    "phone_result_layout": "PHOTO_TOP_RESULT_BELOW",
    "breakpoint_css_px": 1024,
    "product_scene_has_no_editor_layer_panel": true
  },
  "visual_tokens": {
    "page": "#F7FAF8",
    "page_alt": "#EEF5F2",
    "surface": "#FFFFFF",
    "deep_text": "#173A3B",
    "secondary_text": "#6D8180",
    "teal": "#286B63",
    "teal_dark": "#184C4A",
    "pale_teal": "#DCECE8",
    "morning_gold": "#D9AE62",
    "border": "#D9E5E0",
    "warning": "#9A6B34",
    "desktop_gutter_px": 32,
    "tablet_gutter_px": 24,
    "phone_gutter_px": 16,
    "max_width_px": 1280,
    "desktop_result_columns": [
      58,
      42
    ],
    "desktop_result_gap_px": 24,
    "min_target_px": 44
