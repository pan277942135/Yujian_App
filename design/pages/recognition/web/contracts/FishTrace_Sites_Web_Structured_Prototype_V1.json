  "interaction_rules": {
    "entry_cta": "must show source choice first",
    "camera_and_gallery": "both converge to the same preview state; gallery works independently",
    "local_file_handling": "Object URL / browser memory only; revoke old object URLs on replacement/reset",
    "photo_upload": false,
    "inference": "not connected; never claim a real model result",
    "sample_result": "DEMO_DATA_ONLY; outer prototype banner stays visible",
    "mask_trust": "NONE for fixture; no precise fish contour or gold transfer",
    "animation": "editor timeline preview only; not production timing evidence",
    "reset": "clears selected file and returns to entry",
    "keyboard": "all controls are buttons/links with visible focus and accessible labels",
    "rr09_reveal": {
      "duration_ms": 850,
      "frames": [
        "R0",
        "R0.5",
        "R1",
        "R2",
        "R3",
        "R4",
        "R5"
      ],
      "r05_global_time_ms": 2900,
      "mask_trust_state": "NONE",
      "fallback": "restrained Chinese title fade only",
      "fabricated_fish_contour": false,
      "fabricated_gold_transfer": false,
      "transition_to_result": "after demo timeline completes; not real inference evidence"
    }
  },
