  "source_asset": {
    "path": "design/system/fish_media_display_v1/assets/real_catch_source.jpg",
    "use": "DESIGN_FIXTURE_ONLY",
    "public_design_asset_already_registered": true,
    "is_user_photo": false,
    "is_inference_evidence": false,
    "foreground_fit": "contain",
    "backdrop_rule": "same source, blurred and low contrast",
    "no_remote_photo_upload": true
  },
  "scenes": [
    {
      "id": "entry",
      "label": "入口",
      "state_ref": "S0_LANDING_ENTRY",
      "product_description": "Single immersive entry scene with one primary CTA.",
      "primary_action": "拍照识鱼开始",
      "next": "source-choice"
    },
    {
      "id": "source-choice",
      "label": "来源选择",
      "state_ref": "S1_SOURCE_CHOICE",
      "product_description": "Show camera and gallery options before opening either source.",
      "primary_actions": [
        "现场拍照",
        "从相册选择"
      ],
      "next": "preview"
    },
    {
      "id": "preview",
      "label": "照片预览",
      "state_ref": "S3_PHOTO_PREVIEW",
      "product_description": "One complete sharp source photo, secondary metadata and recognition CTA.",
      "primary_action": "开始识别",
      "next": "processing"
    },
    {
      "id": "processing",
      "label": "识别中",
      "state_ref": "S5_PROCESSING_SWOS",
      "product_description": "One photo-led scene, restrained ambient water light and truthful status.",
      "timeline": "P0-P7 / nominal 2800ms; demo only",
      "next": "result"
    },
    {
      "id": "reveal",
      "label": "结果揭晓",
      "state_ref": "S6_RESULT_REVEAL_RR09",
      "product_description": "Same source photo through the RR09 850ms reveal; because the fixture has no trusted Mask, only a restrained Chinese title fade is shown.",
      "timeline": "R0/R0.5/R1/R2/R3/R4/R5 / nominal 850ms; demo only",
      "mask_trust_state": "NONE",
      "next": "result"
    },
    {
      "id": "result",
      "label": "识别结果",
      "state_ref": "S7_RESULT",
      "product_description": "Desktop photo-left/result-right; phone photo-top/result-below.",
      "demo_data_only": true,
      "primary_action": "重新识别"
    },
    {
      "id": "error",
      "label": "异常恢复",
      "state_ref": "S8_ERROR_RECOVERY",
      "product_description": "Clear recovery copy, retry and source replacement.",
      "primary_actions": [
        "重试",
        "从相册选择"
      ]
    }
  ],
  "transitions": [
    {
      "from": "entry",
      "action": "拍照识鱼开始",
      "to": "source-choice"
    },
    {
      "from": "source-choice",
      "action": "现场拍照",
      "to": "local-camera-input"
    },
    {
      "from": "source-choice",
      "action": "从相册选择",
      "to": "local-gallery-input"
    },
    {
      "from": "local-camera-input",
      "action": "photo-selected",
      "to": "preview"
    },
    {
      "from": "local-gallery-input",
      "action": "photo-selected",
      "to": "preview"
    },
    {
      "from": "preview",
      "action": "开始识别",
      "to": "processing"
    },
    {
      "from": "result",
      "action": "重新识别",
      "to": "processing"
    },
    {
      "from": "result",
      "action": "重新拍摄/从相册选择",
      "to": "source-choice"
    },
    {
      "from": "any",
      "action": "关闭/重置",
      "to": "entry"
    },
    {
      "from": "processing",
      "action": "demo-processing-timeline-complete",
      "to": "reveal",
      "qualification": "visual prototype only; no model inference"
    },
    {
      "from": "reveal",
      "action": "RR09-demo-timeline-complete",
      "to": "result",
      "qualification": "visual prototype only; DEMO_DATA_ONLY"
    }
  ],
