  "flow": [
    {
      "id": "S0_LANDING_ENTRY",
      "trigger": "click existing CTA 拍照识鱼开始",
      "actions": [
        "enter existing in-page recognition scene",
        "begin background automatic model preparation"
      ],
      "session_created": false
    },
    {
      "id": "S1_SOURCE_CHOICE",
      "visible_actions": [
        "现场拍照",
        "从相册选择",
        "返回/关闭"
      ],
      "must_show_both_sources_first": true
    },
    {
      "id": "S2_CAMERA_PERMISSION",
      "trigger": "explicit camera action",
      "success_next": "S3_PHOTO_PREVIEW",
      "failure_fallback": "keep gallery available"
    },
    {
      "id": "S3_PHOTO_PREVIEW",
      "requirements": [
        "EXIF normalized",
        "full contain photo",
        "source SHA and dimensions recorded",
        "start recognition",
        "reselect",
        "back/close"
      ],
      "on_reselect": "invalidate previous session and clear all derived data"
    },
    {
      "id": "S4_MODEL_PREPARATION",
      "requirements": [
        "automatic public static model loading",
        "SHA/spec verification",
        "versioned local cache",
        "no manual model upload"
      ],
      "failure": "clear error and retry; never fabricate result"
    },
    {
      "id": "S5_PROCESSING_SWOS",
      "duration_ms": 2800,
      "frames": [
        "P0",
        "P1",
        "P2",
        "P3",
        "P4",
        "P5",
        "P6",
        "P7"
      ],
      "requirements": [
        "same PhotoSession",
        "same source SHA",
        "same transform M(t)",
        "real lifecycle status only",
        "keep full photo visible"
      ]
    },
    {
      "id": "S6_RESULT_REVEAL_RR09",
      "duration_ms": 850,
      "frames": [
        "R0",
        "R0.5",
        "R1",
        "R2",
        "R3",
        "R4",
        "R5"
      ],
      "eligibility": "real valid HIGH result only; full transfer requires TRUSTED_MASK; otherwise restrained title fallback"
    },
    {
      "id": "S7_RESULT",
      "desktop": "photo left, result right",
      "below_1024": "photo top, result below",
      "actions": [
        "重新识别",
        "重新拍摄",
        "从相册选择",
        "关闭"
      ]
    },
    {
      "id": "S8_ERROR_RECOVERY",
      "states": [
        "NO_FISH",
        "IMAGE_QUALITY",
        "MEDIUM",
        "LOW",
        "TECHNICAL_FAILURE",
        "CAMERA_PERMISSION_DENIED",
        "UNSUPPORTED_FILE",
        "EMPTY_FILE",
        "DECODE_FAILURE",
        "OVERSIZE",
        "MODEL_FETCH_FAILURE",
        "MODEL_HASH_FAILURE",
        "MODEL_RUNTIME_FAILURE",
        "INFERENCE_FAILURE"
      ]
    }
  ],
  "photo_session": {
    "single_source_identity": true,
