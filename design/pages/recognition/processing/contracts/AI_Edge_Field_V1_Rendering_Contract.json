    "full_path_persistent": false,
    "full_perimeter_skeleton": false,
    "optional_carrier_max_relative_weight": 0.1
  },
  "alpha_chain": "base_layer_alpha * island_weight * state_strength * resolve_strength * quality_strength",
  "base_alpha": {
    "primary_core": [
      0.2,
      0.46
    ],
    "hot_peak_max": 0.5,
    "mid_glow": [
      0.05,
      0.1
    ],
    "outer_bloom": [
      0.025,
      0.055
    ],
    "receiving_light": [
      0.03,
      0.07
    ]
  },
  "island_weight": {
    "B_UR": 1,
    "G_UL": [
      0.72,
      0.82
    ],
    "G_LL": [
      0.58,
      0.68
    ],
    "B_LR": [
      0.48,
      0.6
    ]
  },
  "platform_mapping": {
    "android": "Compose Canvas / DrawScope / Path",
    "ios": "SwiftUI Canvas / CGPath",
    "harmonyos": "ArkUI Canvas / Path / drawing effects"
  },
  "external_inputs": [
    "state_strength",
    "clock_segment_offset",
    "resolve_strength",
    "quality_level",
    "reduce_motion"
  ],
  "hard_failures": [
    "full_frame_effect_bitmap",
    "independent_corner_widgets",
    "all_seven_paths_persistent",
    "persistent_perimeter_skeleton",
    "constant_parallel_primary_hairline",
