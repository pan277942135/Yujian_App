    "status": "DERIVED_FROM_ANDROID_RUNTIME_AND_RENDERING_CONTRACT",
    "source_orientation": "EXIF-oriented normalized source coordinates",
    "viewport": "full available Recognition screen; safe drawing insets do not remap media or Edge Field",
    "primary_mode": "FIT",
    "visible_source_rect": [
      0,
      0,
      1,
      1
    ],
    "transform": {
      "fit_scale": "min(viewportWidth/sourceWidth, viewportHeight/sourceHeight)",
      "crop_scale": "max(viewportWidth/sourceWidth, viewportHeight/sourceHeight)",
      "drawn_width": "sourceWidth * scale",
      "drawn_height": "sourceHeight * scale",
      "translation_x": "(viewportWidth - drawnWidth) / 2",
      "translation_y": "(viewportHeight - drawnHeight) / 2",
      "source_normalized_to_viewport": [
        "translationX + x * drawnWidth",
        "translationY + y * drawnHeight"
      ],
      "optical_normalized_to_photo_content": [
        "photoContentRect.left + x * photoContentRect.width",
        "photoContentRect.top + y * photoContentRect.height"
      ],
      "photo_content_rect": [
        "max(0, translationX)",
        "max(0, translationY)",
        "min(viewportWidth, translationX+drawnWidth)",
        "min(viewportHeight, translationY+drawnHeight)"
      ]
    },
    "rules": [
      "one primary transform drives original photo, detector bbox, mask/contour, halo, Edge Field, nodes and particle anchors",
      "FIT letterbox bands are excluded from photoContentRect",
      "same-source CROP may fill letterbox decoratively at alpha 0.16; it is never used for overlays",
      "Edge Field authored coordinates may overshoot [0,1]; do not clamp them; clip drawing to photoContentRect",
      "bbox and mask points use the same EXIF-oriented source transform",
      "detector bbox arrival must not change primary transform",
      "system safe insets affect Back and Status controls only"
    ],
    "example": {
      "source_px": [
        2000,
        1000
      ],
      "viewport_px": [
        1000,
