{
  "version": "1.0",
  "status": "FROZEN",
  "id": "yujian_default_profile_avatar_v1",
  "scope": "Normal Home Header / logged-in avatar fallback",
  "owner": "NH02 First Catch Home V1",
  "design_authority": "design/pages/home/normal_home/02_first_catch/README.md",
  "android_implementation_reference": "app/src/main/res/drawable/profile_fallback_v13.xml",
  "semantics": {
    "logged_in_avatar_available": "REAL_USER_AVATAR",
    "logged_in_avatar_missing": "DEFAULT_PROFILE_AVATAR_V1",
    "logged_in_avatar_load_failure": "DEFAULT_PROFILE_AVATAR_V1",
    "guest": "GUEST_ACCOUNT_ENTRY",
    "default_avatar_is_guest": false
  },
  "visual": {
    "shape": "CIRCLE",
    "display_diameter_reference_px": 92,
    "reference_canvas": [
      1080,
      1920
    ],
    "vector_viewport": [
      96,
      96
    ],
    "outer_disc": {
      "center": [
        48,
        48
      ],
      "radius": 43,
      "fill": "#6BFFFFFF",
      "stroke": "#9EFFFFFF",
      "stroke_width": 2
    },
    "person_icon": {
      "stroke": "#30485A",
      "stroke_width": 4,
      "shoulder_line_cap": "ROUND",
      "head_circle": {
        "center": [
          48,
          37
        ],
        "radius": 13
      }
    }
  },
  "interaction": {
    "tap": "OPEN_MY_PROFILE",
    "same_as_real_avatar": true,
    "disabled": false,
    "automatic_prompt": false
  },
  "forbidden": [
    "Guest avatar used for logged-in fallback",
    "initial-letter avatar",
    "random-color avatar",
    "AI-generated default face",
    "fish logo as person substitute",
    "missing-avatar text label",
    "automatic Edit Profile prompt"
  ],
  "presentation_ownership": {
    "NH02": "semantic and fallback authority",
    "NH04": "multi-state visual comparison only; may not redefine fallback"
  }
}
