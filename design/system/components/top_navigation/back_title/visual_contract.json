{
  "component": "top_navigation",
  "variant": "BACK_TITLE",
  "version": "V1",
  "status": "FROZEN",
  "geometry": {
    "safe_area_owner": "host_page",
    "min_content_height_dp": 56,
    "height_behavior": "heightIn(min=56dp)",
    "horizontal_padding_dp": 8,
    "back_touch_target_dp": 44,
    "back_glyph_dp": 22,
    "back_title_gap_dp": 8,
    "title_alignment": "left_after_back",
    "trailing_reserved_slot": false,
    "background": "transparent",
    "divider": false
  },
  "typography": {
    "font_size_sp": 20,
    "line_height_sp": 26,
    "weight": 500,
    "color": "#0B2D4B",
    "alignment": "left",
    "max_lines_normal_scale": 1,
    "overflow": "ellipsis",
    "gold": false
  },
  "back_action": {
    "authority": "Icon Action V1 / NAVIGATION / Back",
    "content_description": "返回",
    "custom_container": false,
    "text_glyph_prohibited": true,
    "component_level_haptic": "none",
    "sound": "none"
  },
  "small_screen": {
    "width_range_dp": "320-359",
    "keep_font_size_sp": 20,
    "shrink_font": false,
    "overflow": "ellipsis"
  },
  "accessibility": {
    "allow_height_growth": true,
    "clip_text": false,
    "manual_font_downscale": false,
    "keep_back_centered": true
  },
  "content_exclusions": [
    "subtitle",
    "utility_actions",
    "fake_balance_spacer",
    "glass_bar",
    "divider"
  ]
}
