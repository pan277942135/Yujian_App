    "head_distance": "0.5 - 0.5*cos(2*pi*p)",
    "direction": "sign(sin(2*pi*p))",
    "trail_tail_fraction": {
      "green": 0.23,
      "cyan": 0.2,
      "gold": 0.15
    },
    "deterministic_curve_deformation": true,
    "random_per_frame": false
  }
}
