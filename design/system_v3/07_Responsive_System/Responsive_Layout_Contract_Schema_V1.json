{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pan277942135/Yujian_App/blob/main/design/system_v3/07_Responsive_System/Responsive_Layout_Contract_Schema_V1.json",
  "title": "YuJian Responsive Layout Contract V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "contract_version",
    "status",
    "page_id",
    "scope",
    "authority",
    "responsive_model",
    "visual_anchors",
    "preview_profiles",
    "layout_regions",
    "logical_allocation",
    "components",
    "typography",
    "spacing",
    "overflow_policy",
    "conflict_resolution",
    "implementation_conformance_followups",
    "native_acceptance",
    "acceptance",
    "change_log"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "contract_id": {
      "type": "string",
      "minLength": 3
    },
    "contract_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PROPOSED_FOR_CANONICAL_MAIN_REVIEW",
        "SPEC_FROZEN"
      ]
    },
    "page_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "required": [
        "route",
        "implementation_route",
        "included_states",
        "excluded_scopes"
      ],
      "properties": {
        "route": {
          "type": "string"
        },
        "implementation_route": {
          "type": "string"
        },
        "included_states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "excluded_scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "required": [
        "global_standard",
        "schema",
        "viewport_profiles",
        "visual_master",
        "static_archive_manifest",
        "static_archive_contract",
        "nonresponsive_authority",
        "legacy_layout_contract",
        "implementation_sources"
      ],
      "properties": {
        "global_standard": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "viewport_profiles": {
          "type": "string"
        },
        "visual_master": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "static_archive_manifest": {
          "type": "string"
        },
        "static_archive_contract": {
          "type": "string"
        },
        "nonresponsive_authority": {
          "type": "string"
        },
        "legacy_layout_contract": {
          "type": "string"
        },
        "implementation_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "responsive_model": {
      "type": "object",
      "required": [
        "model",
        "active_variant",
        "comparison_only_variants",
        "non_authoritative_variants",
        "inputs",
        "viewport_keyed_layout_overrides",
        "breakpoint_policy",
        "explicit_thresholds"
      ],
      "properties": {
        "model": {
          "const": "CONSTRAINT_DRIVEN_SINGLE_POLICY"
        },
        "active_variant": {
          "type": "string"
        },
        "comparison_only_variants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "non_authoritative_variants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "viewport_keyed_layout_overrides": {
          "const": false
        },
        "breakpoint_policy": {
          "type": "string"
        },
        "explicit_thresholds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "condition",
              "purpose"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "condition": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "visual_anchors": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/visualAnchor"
      }
    },
    "preview_profiles": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/previewProfile"
      }
    },
    "layout_regions": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "rules"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "rules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "logical_allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "safe_height_formula",
        "bands",
        "surplus_formula",
        "allocation_when_positive_surplus",
        "allocation_when_zero_surplus",
        "base_gap_sources",
        "invariants"
      ],
      "properties": {
        "safe_height_formula": {"type": "string"},
        "bands": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "logical_content", "physical_region"],
            "properties": {
              "id": {"enum": ["A", "B", "C"]},
              "logical_content": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "physical_region": {"type": "string"}
            }
          }
        },
        "surplus_formula": {"type": "string"},
        "allocation_when_positive_surplus": {
          "type": "object",
          "additionalProperties": false,
          "required": ["a_to_b", "b_to_c"],
          "properties": {"a_to_b": {"type": "string"}, "b_to_c": {"type": "string"}}
        },
        "allocation_when_zero_surplus": {
          "type": "object",
          "additionalProperties": false,
          "required": ["a_to_b", "b_to_c"],
          "properties": {"a_to_b": {"type": "string"}, "b_to_c": {"type": "string"}}
        },
        "base_gap_sources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gAB_base", "gBC_base"],
          "properties": {"gAB_base": {"type": "string"}, "gBC_base": {"type": "string"}}
        },
        "invariants": {"type": "array", "minItems": 4, "items": {"type": "string"}}
      }
    },
    "components": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "rules",
          "constraints"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "rules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "constraints": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "typography": {
      "type": "object",
      "required": [
        "viewport_scale_formula",
        "base_size_formula",
        "system_font_scale_rule",
        "roles",
        "wrapping_rules",
        "global_shrink_forbidden"
      ],
      "properties": {
        "viewport_scale_formula": {
          "type": "string"
        },
        "base_size_formula": {
          "type": "string"
        },
        "system_font_scale_rule": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "minItems": 8,
          "items": {
            "$ref": "#/$defs/typographyRole"
          }
        },
        "wrapping_rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "global_shrink_forbidden": {
          "const": true
        }
      }
    },
    "spacing": {
      "type": "object",
      "required": [
        "formulas",
        "title_to_card_anchor_targets",
        "static_only_targets",
        "required_interval_measurements"
      ],
      "properties": {
        "formulas": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        },
        "title_to_card_anchor_targets": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "required": [
              "profile_id",
              "target_dp",
              "tolerance_dp",
              "font_scale",
              "measurement"
            ],
            "properties": {
              "profile_id": {
                "type": "string"
              },
              "target_dp": {
                "type": "number"
              },
              "tolerance_dp": {
                "type": "number"
              },
              "font_scale": {
                "type": "number"
              },
              "measurement": {
                "type": "string"
              }
            }
          }
        },
        "static_only_targets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "profile_id",
              "target_dp",
              "tolerance_dp",
              "native_runtime_authority",
              "reason"
            ],
            "properties": {
              "profile_id": {
                "type": "string"
              },
              "target_dp": {
                "type": "number"
              },
              "tolerance_dp": {
                "type": "number"
              },
              "native_runtime_authority": {
                "const": false
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "required_interval_measurements": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "object",
            "required": [
              "id",
              "measurement",
              "checks"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "measurement": {
                "type": "string"
              },
              "checks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "overflow_policy": {
      "type": "object",
      "required": [
        "priority_order",
        "resolution_steps",
        "footer_fixed_outside_middle",
        "no_global_shrink",
        "failure_states"
      ],
      "properties": {
        "priority_order": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string"
          }
        },
        "resolution_steps": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        },
        "footer_fixed_outside_middle": {
          "const": true
        },
        "no_global_shrink": {
          "const": true
        },
        "failure_states": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "conflict_resolution": {
      "type": "array",
      "minItems": 7,
      "items": {
        "$ref": "#/$defs/conflictResolution"
      }
    },
    "implementation_conformance_followups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "issue",
          "required_action",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "issue": {
            "type": "string"
          },
          "required_action": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PENDING_IMPLEMENTATION",
              "VERIFIED",
              "BLOCKED"
            ]
          }
        }
      }
    },
    "native_acceptance": {
      "type": "object",
      "required": [
        "status",
        "matrix_path",
        "required_case_count",
        "viewports",
        "font_scales",
        "variants",
        "m05_excluded_from_native_matrix",
        "pass_requires"
      ],
      "properties": {
        "status": {
          "const": "NOT_VERIFIED"
        },
        "matrix_path": {
          "type": "string"
        },
        "required_case_count": {
          "const": 24
        },
        "viewports": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string"
          }
        },
        "font_scales": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "number"
          }
        },
        "variants": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "id",
              "role"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "role": {
                "type": "string"
              }
            }
          }
        },
        "m05_excluded_from_native_matrix": {
          "const": true
        },
        "pass_requires": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "acceptance": {
      "type": "object",
      "required": [
        "no_per_viewport_layouts",
        "exact_sha_required",
        "runtime_status_independent",
        "required_gates",
        "continuity_probe_ids"
      ],
      "properties": {
        "no_per_viewport_layouts": {
          "const": true
        },
        "exact_sha_required": {
          "const": true
        },
        "runtime_status_independent": {
          "const": true
        },
        "required_gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "continuity_probe_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "change_log": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "version",
          "date",
          "change"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "change": {
            "type": "string"
          }
        }
      }
    },
    "preview_engine": {
      "$ref": "#/$defs/previewEngine"
    }
  },
  "$defs": {
    "visualAnchor": {
      "type": "object",
      "required": [
        "id",
        "role",
        "path",
        "sha256",
        "canvas_px",
        "logical_viewport_dp",
        "source_asset_id",
        "status",
        "rule"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "canvas_px": {
          "type": "object",
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "logical_viewport_dp": {
          "type": "object",
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "number",
              "minimum": 1
            },
            "height": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 1
            }
          }
        },
        "source_asset_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "const": "FROZEN"
        },
        "rule": {
          "type": "string"
        }
      }
    },
    "previewProfile": {
      "type": "object",
      "required": [
        "profile_id",
        "profile_kind",
        "width_dp",
        "height_dp",
        "preview_enabled",
        "native_matrix",
        "anchor_ids",
        "purpose"
      ],
      "properties": {
        "profile_id": {
          "type": "string"
        },
        "profile_kind": {
          "enum": [
            "FIXED_LOGICAL_DP",
            "WIDTH_BOUNDARY_ONLY"
          ]
        },
        "width_dp": {
          "type": "number",
          "minimum": 1
        },
        "height_dp": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1
        },
        "preview_enabled": {
          "type": "boolean"
        },
        "native_matrix": {
          "type": "boolean"
        },
        "anchor_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "purpose": {
          "type": "string"
        }
      }
    },
    "typographyRole": {
      "type": "object",
      "required": [
        "id",
        "base_ratio",
        "min_sp",
        "max_sp",
        "line_height_ratio",
        "size_formula",
        "system_font_scale"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "base_ratio": {
          "type": [
            "number",
            "null"
          ]
        },
        "min_sp": {
          "type": [
            "number",
            "null"
          ]
        },
        "max_sp": {
          "type": [
            "number",
            "null"
          ]
        },
        "line_height_ratio": {
          "type": [
            "number",
            "null"
          ]
        },
        "size_formula": {
          "type": "string"
        },
        "system_font_scale": {
          "type": "string"
        }
      }
    },
    "conflictResolution": {
      "type": "object",
      "required": [
        "id",
        "topic",
        "decision",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "topic": {
          "type": "string"
        },
        "decision": {
          "type": "string"
        },
        "status": {
          "enum": [
            "RESOLVED_BY_PROPOSED_CONTRACT",
            "SCOPED_NOT_CONFLICTING"
          ]
        }
      }
    },
    "jsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    },
    "previewEngine": {
      "type": "object",
      "required": [
        "schema_version",
        "engine_id",
        "coordinate_space",
        "inputs",
        "parameters",
        "role_bindings"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "engine_id": {
          "type": "string"
        },
        "coordinate_space": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "parameters": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        "role_bindings": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
