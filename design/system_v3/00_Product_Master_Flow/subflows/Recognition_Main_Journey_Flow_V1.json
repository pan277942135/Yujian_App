{
  "schema_version": "1.0",
  "contract_id": "recognition_main_journey_business_contract_v1",
  "status": "FROZEN",
  "version": "1.0",
  "date": "2026-10-15",
  "authority_parent": "design/system_v3/00_Product_Master_Flow/master_flow_v3_1.json",
  "source_contract": "design/system_v3/00_Product_Master_Flow/subflows/Recognition_Main_Journey_Business_Contract_V1.md",
  "existing_page_authorities": [
    "design/system_v3/08_Page_Contracts/recognition/capture/Recognition_Capture_Page_Contract_V3_1.md",
    "design/system_v3/08_Page_Contracts/recognition/processing/Recognition_Processing_Page_Contract_V3_1.md",
    "design/system_v3/08_Page_Contracts/recognition/result/Recognition_Result_Page_Contract_V3_1.md",
    "design/system_v3/08_Page_Contracts/recognition/result/State_Machine_V3_1.json"
  ],
  "entities": [
    {"id":"recognitionSessionId","meaning":"one user-initiated journey; contains one or more attempts; ends on verified save or exit without a record"},
    {"id":"recognitionAttemptId","meaning":"one new camera/gallery image and one inference; stale callbacks are invalidated"},
    {"id":"imageId","meaning":"one readable normalized photo supplied to an attempt"},
    {"id":"recognitionDraft","meaning":"temporary result, confirmed species, metadata, story, and destination; never itself a FishRecord"},
    {"id":"clientRecordId","meaning":"stable idempotency key for one logical save across retries and outcome lookup"},
    {"id":"fishRecord","meaning":"durable record created only after explicit save intent and verified persistence"}
  ],
  "nodes": [
    {"id":"HOME_EMPTY","route":"home","kind":"home_state","entry_guard":"0 valid FishRecord","record_delta":0},
    {"id":"SESSION_START","route":"identify","kind":"session_start","entry_guard":"user taps camera or gallery","creates":"recognitionSessionId"},
    {"id":"CAMERA_PERMISSION","route":"identify","kind":"permission_gate","branches":["GRANTED","DENIED_REQUESTABLE","DENIED_PERMANENT"]},
    {"id":"CAMERA_READY","route":"identify","kind":"capture_ready","guard":"permission granted and CameraX Provider + Preview ready"},
    {"id":"CAPTURE_GUIDE","route":"identify","kind":"one_time_overlay","guard":"camera path and capture_guide_v1_completed=false and Preview ready"},
    {"id":"PHOTO_PICKER","route":"system_photo_picker","kind":"system_ui","guard":"available independent of camera permission"},
    {"id":"NORMALIZED_IMAGE","route":"identify","kind":"image_handoff","guard":"exactly one readable orientation-normalized image","creates":"recognitionAttemptId,imageId"},
    {"id":"PROCESSING_CAPTURED","route":"recognizing","kind":"pipeline_state","minimum_ms":220},
    {"id":"PROCESSING_DETECTING","route":"recognizing","kind":"pipeline_state","minimum_ms":320},
    {"id":"PROCESSING_OUTLINE","route":"recognizing","kind":"pipeline_state","minimum_ms":350},
    {"id":"PROCESSING_CLASSIFYING","route":"recognizing","kind":"pipeline_state","minimum_ms":250},
    {"id":"RESULT_HIGH","route":"result","kind":"species_result","save_guard":"Top-1 may be edited; user save intent required"},
    {"id":"RESULT_MEDIUM","route":"result","kind":"species_result","save_guard":"explicit candidate or species selection required"},
    {"id":"RESULT_LOW","route":"result","kind":"species_result","save_guard":"manual species selection required; unresolved cannot save"},
    {"id":"NO_FISH","route":"recognition_issue","kind":"recovery_result","save_allowed":false,"recovery":["RETAKE","GALLERY"]},
    {"id":"IMAGE_QUALITY","route":"recognition_issue","kind":"recovery_result","save_allowed":false,"guard":"real Quality Gate INVALID and reason is not NO_FISH"},
    {"id":"TECHNICAL_FAILURE","route":"recognition_issue","kind":"technical_recovery","in_three_plus_two":false,"save_allowed":false},
    {"id":"SPECIES_CONFIRMED","route":"result","kind":"confirmation_state","guard":"explicit user species confirmation"},
    {"id":"SAVE_IN_PROGRESS","route":"result","kind":"persistence_state","guard":"explicit Save Catch or Continue Memory intent","duplicate_submission":false},
    {"id":"SAVE_ERROR","route":"result","kind":"recoverable_error","preserve":["image","draft","destination","clientRecordId"]},
    {"id":"SAVE_OUTCOME_UNKNOWN","route":"result","kind":"idempotency_lookup","guard":"timeout/response loss; query clientRecordId before another write"},
    {"id":"SAVED_HOME","route":"home","kind":"terminal_success","record_delta":1,"back_stack":["home"]},
    {"id":"SAVED_MEMORY","route":"catch/{id}?section=memory","kind":"terminal_success","record_delta":1,"back_stack":["home","fish_record_detail"]},
    {"id":"EXIT_UNSAVED","route":"capture_or_home","kind":"terminal_exit","record_delta":0}
  ],
  "transitions": [
    {"from":"HOME_EMPTY","action":"tap camera","to":"SESSION_START","trigger":"explicit user action"},
    {"from":"SESSION_START","action":"camera path","to":"CAMERA_PERMISSION","trigger":"permission resolution starts after user action"},
    {"from":"SESSION_START","action":"gallery path","to":"PHOTO_PICKER","trigger":"picker bypasses camera permission and guide"},
    {"from":"CAMERA_PERMISSION","action":"granted and preview ready","to":"CAMERA_READY","guard":"CameraX is actually ready"},
    {"from":"CAMERA_PERMISSION","action":"denied","to":"PHOTO_PICKER","guard":"camera remains stopped; gallery remains available"},
    {"from":"CAMERA_READY","action":"first-use guide incomplete","to":"CAPTURE_GUIDE","guard":"camera entry and Preview ready"},
    {"from":"CAPTURE_GUIDE","action":"skip or start capture","to":"CAMERA_READY","effect":"dismiss and persist completed=true; no automatic shutter"},
    {"from":"CAMERA_READY","action":"shutter","to":"NORMALIZED_IMAGE","trigger":"one successful Capture"},
    {"from":"PHOTO_PICKER","action":"select valid image","to":"NORMALIZED_IMAGE","trigger":"image decoded and normalized"},
    {"from":"PHOTO_PICKER","action":"cancel","to":"SESSION_START","effect":"restore Capture; no inference and no record"},
    {"from":"NORMALIZED_IMAGE","action":"begin recognition","to":"PROCESSING_CAPTURED","trigger":"real normalized input accepted"},
    {"from":"PROCESSING_CAPTURED","action":"real detection starts after minimum beat","to":"PROCESSING_DETECTING"},
    {"from":"PROCESSING_DETECTING","action":"real eligible fish focus after minimum beat","to":"PROCESSING_OUTLINE"},
    {"from":"PROCESSING_OUTLINE","action":"real classification starts after minimum beat","to":"PROCESSING_CLASSIFYING"},
    {"from":"PROCESSING_CLASSIFYING","action":"real result after minimum beat","to":"RESULT_HIGH|RESULT_MEDIUM|RESULT_LOW|NO_FISH|IMAGE_QUALITY"},
    {"from":"PROCESSING_CAPTURED|PROCESSING_DETECTING|PROCESSING_OUTLINE|PROCESSING_CLASSIFYING","action":"real pipeline/model/crop failure","to":"TECHNICAL_FAILURE","effect":"cancel/invalidate attempt and do not blame image"},
    {"from":"PROCESSING_CAPTURED|PROCESSING_DETECTING|PROCESSING_OUTLINE|PROCESSING_CLASSIFYING","action":"Back","to":"EXIT_UNSAVED","destination":"Capture","effect":"cancel attempt and invalidate late callbacks"},
    {"from":"RESULT_MEDIUM","action":"confirm candidate or commit species selector","to":"SPECIES_CONFIRMED"},
    {"from":"RESULT_LOW","action":"manual species selection","to":"SPECIES_CONFIRMED"},
    {"from":"RESULT_HIGH|SPECIES_CONFIRMED","action":"Save Catch or Continue Memory","to":"SAVE_IN_PROGRESS","guard":"explicit user intent; valid selected species"},
    {"from":"SAVE_IN_PROGRESS","action":"verified durable persistence","to":"SAVED_HOME|SAVED_MEMORY","effect":"create exactly one FishRecord and clear recognition stack"},
    {"from":"SAVE_IN_PROGRESS","action":"definite failure","to":"SAVE_ERROR","effect":"retain draft and retry key"},
    {"from":"SAVE_IN_PROGRESS","action":"outcome unknown","to":"SAVE_OUTCOME_UNKNOWN","effect":"lookup by same clientRecordId before another write"},
    {"from":"SAVE_OUTCOME_UNKNOWN","action":"record found and verified","to":"SAVED_HOME|SAVED_MEMORY"},
    {"from":"SAVE_OUTCOME_UNKNOWN","action":"record confirmed absent","to":"SAVE_ERROR","effect":"retry with the same clientRecordId"},
    {"from":"NO_FISH|IMAGE_QUALITY|TECHNICAL_FAILURE","action":"Retake","to":"CAMERA_READY","effect":"clear active result and require a new image/attempt"},
    {"from":"NO_FISH|IMAGE_QUALITY|TECHNICAL_FAILURE","action":"Gallery","to":"PHOTO_PICKER","effect":"only a newly selected valid image starts another attempt"},
    {"from":"RESULT_HIGH|RESULT_MEDIUM|RESULT_LOW","action":"Back with no substantive edit","to":"EXIT_UNSAVED","destination":"Capture","record_delta":0},
    {"from":"RESULT_HIGH|RESULT_MEDIUM|RESULT_LOW","action":"Back/Retake with dirty draft","to":"EXIT_UNSAVED","guard":"explicit Continue editing or Discard edit choice","record_delta":0},
    {"from":"RESULT_HIGH|RESULT_MEDIUM|RESULT_LOW","action":"Retake","to":"CAMERA_READY","effect":"clear prior result and require a different new image"}
  ],
  "invariants": [
    "No FishRecord exists before verified persistence after explicit user save intent.",
    "A logical save and all retries reuse the same clientRecordId.",
    "A session may contain many attempts but may create at most one FishRecord.",
    "Every new capture/gallery selection gets a new imageId and recognitionAttemptId.",
    "No stale attempt callback may alter current result or navigation.",
    "Medium and Low require explicit species confirmation.",
    "NO_FISH is evaluated before IMAGE_QUALITY; WARNING alone is not IMAGE_QUALITY.",
    "TECHNICAL_FAILURE is outside 3+2 and never claims the photo is poor.",
    "Result/Processing/Capture history is removed after successful save.",
    "Unsuccessful, canceled, abandoned, or recovery-only routes create zero records."
  ]
}
