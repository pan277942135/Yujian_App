  "normal_home_coordinate_transform": {
    "authority": "design/pages/home/normal_home/engineering/Layout_Responsive_Contract_V1.md",
    "inputs": "same-window app W,H,L,T,R,B,d,fontScale",
    "formula": {
      "Wsafe": "max(0,W-L-R)",
      "Hsafe": "max(0,H-T-B)",
      "S": "Wsafe/1080",
      "E": "max(0,Hsafe-1920*S)",
      "delta": "min(0.36*E,180*S)",
      "x": "L+frozenX*S",
      "y": "frozenY*S+delta (do not add T)",
      "width": "frozenWidth*S",
      "height": "frozenHeight*S"
    },
    "baseline_result": "1080x1920 with zero insets yields S=1 and delta=0.",
    "screenshot_crop": "FORBIDDEN"
  },
  "empty_home_coordinate_transform": {
    "authority": "design/pages/home/empty_home/shared/contracts/responsive_mapping_contract.json",
    "scene": "uniform cover on edge-to-edge scene canvas; all scene-locked layers share one transform",
    "hero": "aspect-preserving FIT",
    "controls": "safe-top and safe-bottom group use measured safeDrawing insets once",
    "do_not_apply": "Normal Home common vertical delta"
  },
  "tolerances": {
    "normal_home_geometry": {
      "formula": "max(2px,0.002*WsafePx)",
