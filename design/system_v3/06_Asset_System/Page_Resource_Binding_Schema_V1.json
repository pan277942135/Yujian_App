{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pan277942135.github.io/Yujian_App/design/system_v3/06_Asset_System/Page_Resource_Binding_Schema_V1.json",
  "title": "YuJian Page Resource Binding V1",
  "description": "Page-owned resource references. The Experience Registry remains the page index; this schema does not define a global asset registry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding_id",
    "page_id",
    "page_id_aliases",
    "owner_path",
    "authority_version",
    "page_identity_authority",
    "authority_version_source",
    "source_authorities",
    "publication_policy",
    "page_notes",
    "asset_bindings"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "binding_id": { "type": "string", "minLength": 1 },
    "page_id": { "type": "string", "minLength": 1 },
    "page_id_aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "page_id_alias_sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/fieldReference" }
    },
    "owner_path": { "$ref": "#/$defs/repositoryPath" },
    "authority_version": { "type": "string", "minLength": 1 },
    "page_identity_authority": { "$ref": "#/$defs/fieldReference" },
    "authority_version_source": { "$ref": "#/$defs/fieldReference" },
    "source_authorities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/authority" }
    },
    "publication_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_id", "public_scope_marker"],
      "properties": {
        "authority_id": { "type": "string", "minLength": 1 },
        "public_scope_marker": { "type": "string", "minLength": 1 }
      }
    },
    "page_notes": { "type": "array", "items": { "type": "string" } },
    "asset_bindings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/assetBinding" }
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "fieldReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_id", "json_pointer", "field_pointer"],
      "properties": {
        "authority_id": { "type": "string", "minLength": 1 },
        "json_pointer": { "type": "string" },
        "field_pointer": { "type": "string" },
        "expected_value": {}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_id", "path", "sha256", "purpose"],
      "properties": {
        "authority_id": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/repositoryPath" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "purpose": { "type": "string", "minLength": 1 }
      }
    },
    "publicationPermission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "authority_id", "scope"],
      "properties": {
        "state": {
          "enum": [
            "PUBLIC_BY_EXISTING_PAGES_RULE",
            "PRIVATE_NOT_DISTRIBUTABLE",
            "NOT_CONFIRMED",
            "NOT_IN_PAGES_SCOPE"
          ]
        },
        "authority_id": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "policy_marker": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "dimensions": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_id", "json_pointer"],
      "properties": {
        "authority_id": { "type": "string", "minLength": 1 },
        "json_pointer": { "type": "string" },
        "field_map": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "assetBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_id",
        "asset_id",
        "asset_role",
        "source_path",
        "source_authorities",
        "media_type",
        "bytes",
        "sha256",
        "pixel_dimensions",
        "coordinate_space",
        "fit_crop_policy",
        "lifecycle_status",
        "asset_designation",
        "publication_permission",
        "requiredness"
      ],
      "properties": {
        "page_id": { "type": "string", "minLength": 1 },
        "asset_id": { "type": "string", "minLength": 1 },
        "asset_role": { "type": "string", "minLength": 1 },
        "source_path": { "oneOf": [{ "$ref": "#/$defs/repositoryPath" }, { "type": "null" }] },
        "source_authorities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceReference" }
        },
        "media_type": { "type": ["string", "null"] },
        "bytes": { "type": ["integer", "null"], "minimum": 0 },
        "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "pixel_dimensions": { "$ref": "#/$defs/dimensions" },
        "coordinate_space": { "type": ["string", "null"] },
        "fit_crop_policy": { "type": ["string", "null"] },
        "lifecycle_status": { "type": "string", "minLength": 1 },
        "asset_designation": {
          "enum": ["ORIGINAL", "ILLUSTRATIVE_ONLY", "REFERENCE_ONLY", "NOT_VERIFIED", "NOT_APPLICABLE"]
        },
        "publication_permission": { "$ref": "#/$defs/publicationPermission" },
        "requiredness": { "enum": ["REQUIRED", "OPTIONAL", "NOT_VERIFIED"] },
        "missing_reason": { "type": "string" },
        "degradation_policy": { "type": "string" },
        "declared_source_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "notes": { "type": "array", "items": { "type": "string" } }
      },
      "allOf": [
        {
          "if": { "properties": { "source_path": { "type": "string" } }, "required": ["source_path"] },
          "then": {
            "properties": {
              "bytes": { "type": "integer", "minimum": 0 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "media_type": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "if": { "properties": { "source_path": { "type": "null" } }, "required": ["source_path"] },
          "then": {
            "properties": {
              "bytes": { "type": "null" },
              "sha256": { "type": "null" },
              "media_type": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "publication_permission": {
                "properties": { "state": { "const": "PUBLIC_BY_EXISTING_PAGES_RULE" } },
                "required": ["state"]
              }
            },
            "required": ["publication_permission"]
          },
          "then": { "properties": { "publication_permission": { "required": ["policy_marker"] } } }
        },
        {
          "if": { "properties": { "source_path": { "type": "null" } }, "required": ["source_path"] },
          "then": { "required": ["missing_reason"] }
        },
        {
          "if": { "properties": { "asset_designation": { "const": "ILLUSTRATIVE_ONLY" } }, "required": ["asset_designation"] },
          "then": {
            "properties": {
              "requiredness": { "enum": ["OPTIONAL", "NOT_VERIFIED"] },
              "degradation_policy": { "type": "string", "minLength": 1 }
            },
            "required": ["degradation_policy"]
          }
        }
      ]
    }
  }
}
