+package com.yujian.ai.ui.waterlight.core
+
+/** Stable IDs for non-model production gates. Values are part of Gate Policy V1. */
+enum class RecognitionGateId {
+    PHOTO_FIRST_FRAME,
+    PROCESSING_GEOMETRY,
+    ORB_ANCHOR,
+    RELEASE_RENDER,
+    PERIMETER_ARRIVAL_RENDER,
+    REVEAL_DECISION,
+    MASK_CONTOUR_PSTAR,
+    PATH_BOUND,
