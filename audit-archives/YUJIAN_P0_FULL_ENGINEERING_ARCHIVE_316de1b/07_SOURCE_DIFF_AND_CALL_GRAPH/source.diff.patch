+    const val MODEL_ATTEMPT_DEADLINE_MS = 60_000L
+    const val MAX_SINGLE_NON_MODEL_GATE_MS = 3_000L
+    const val MAX_NON_MODEL_BLOCKED_WAIT_PER_ATTEMPT_MS = 10_000L
+    const val PIXELCOPY_CAPTURE_TIMEOUT_MS = 1_500L
+
+    private fun gate(
+        id: RecognitionGateId,
+        timeout: Long,
+        retries: Int,
+        start: String,
+        success: String,
+        failure: String,
+        counts: Boolean = true,
+        dependsOn: Set<RecognitionGateId> = emptySet(),
+    ) = RecognitionGateDeadlineSpec(
+        id, timeout, retries, if (counts) timeout else 0L, counts,
+        start, success, failure,
+        if (counts) RecognitionGateFailureAction.BLOCK_DOWNSTREAM else RecognitionGateFailureAction.EVIDENCE_ONLY,
+        dependsOn,
+    )
+
+    val specs: Map<RecognitionGateId, RecognitionGateDeadlineSpec> = listOf(
+        gate(RecognitionGateId.PHOTO_FIRST_FRAME, 3_000, 2, "PHOTO_STABLE_FIRST_FRAME_REQUEST", "PHOTO_FRAME_COMMITTED", "PHOTO_FIRST_FRAME_TIMEOUT"),
+        gate(RecognitionGateId.PROCESSING_GEOMETRY, 2_000, 1, "NORMALIZED_PHOTO_GEOMETRY_REQUEST", "PROCESSING_GEOMETRY_READY", "PROCESSING_GEOMETRY_TIMEOUT", dependsOn = setOf(RecognitionGateId.PHOTO_FIRST_FRAME)),
+        gate(RecognitionGateId.ORB_ANCHOR, 1_500, 1, "ORB_WAKE_ENTERED", "ORB_ANCHOR_READY", "ORB_ANCHOR_TIMEOUT", dependsOn = setOf(RecognitionGateId.PROCESSING_GEOMETRY)),
+        gate(RecognitionGateId.RELEASE_RENDER, 1_500, 2, "ORB_RELEASE_ENTERED", "ORB_RELEASE_RENDERED", "RELEASE_RENDER_TIMEOUT", dependsOn = setOf(RecognitionGateId.ORB_ANCHOR)),
+        gate(RecognitionGateId.PERIMETER_ARRIVAL_RENDER, 1_500, 2, "PERIMETER_ARRIVAL_ENTERED", "PERIMETER_ARRIVAL_RENDERED", "PERIMETER_ARRIVAL_RENDER_TIMEOUT", dependsOn = setOf(RecognitionGateId.RELEASE_RENDER)),
